<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Backend Project Dashboard</title>
    <style>
        :root {
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-color: #333333;
            --primary-color: #4a90e2;
            --border-color: #dddddd;
            --success: #2ecc71;
            --warning: #f1c40f;
            --danger: #e74c3c;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
        }
        .section-title {
            color: #2c3e50;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 5px;
            margin-top: 40px;
            margin-bottom: 20px;
        }
        .card {
            background: var(--card-bg);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border-left: 5px solid var(--primary-color);
        }
        .card.get { border-left-color: var(--success); }
        .card.post { border-left-color: var(--primary-color); }
        .card.put { border-left-color: var(--warning); }
        .card.delete { border-left-color: var(--danger); }
        
        .route-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .badge {
            padding: 5px 10px;
            border-radius: 4px;
            color: white;
            font-weight: bold;
            font-size: 12px;
        }
        .badge.get { background-color: var(--success); }
        .badge.post { background-color: var(--primary-color); }
        .badge.put { background-color: var(--warning); }
        .badge.delete { background-color: var(--danger); }

        .route-path {
            font-family: monospace;
            font-size: 16px;
            font-weight: bold;
        }
        .form-group {
            margin-bottom: 12px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
            font-weight: 600;
        }
        input[type="text"], input[type="password"], input[type="file"], textarea {
            width: 100%;
            padding: 8px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            box-sizing: border-box;
        }
        button {
            background-color: #2c3e50;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
        }
        button:hover {
            opacity: 0.9;
        }
        .info-text {
            font-size: 13px;
            color: #7f8c8d;
            margin-top: -5px;
            margin-bottom: 10px;
            display: block;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Project API Testing Forms</h1>
    
    <!-- ================= SECTION 1: TASKS ================= -->
    <h2 class="section-title">📋 Task Management Routes</h2>

    <!-- Get Homepage -->
    <div class="card get">
        <div class="route-header">
            <span class="badge get">GET</span>
            <span class="route-path">/homepage</span>
        </div>
        <p>Fetch all homepage data / tasks list.</p>
        <form action="/notes/homepage" method="GET">
            <button type="submit">Fetch Homepage</button>
        </form>
    </div>

    <!-- Get Specific Task -->
    <div class="card get">
        <div class="route-header">
            <span class="badge get">GET</span>
            <span class="route-path">/homepage/:title</span>
        </div>
        <form action="/notes/get" method="GET">
            <div class="form-group">
                <label>Task Title (Query Search):</label>
                <input type="text" name="title" required placeholder="e.g. Learn-Node">
            </div>
            <button type="submit">Read Specific Task</button>
        </form>
    </div>

    <!-- Create Task -->
    <div class="card post">
        <div class="route-header">
            <span class="badge post">POST</span>
            <span class="route-path">/create</span>
        </div>
        <form action="/notes/create" method="POST">
            <div class="form-group">
                <label>Task Title:</label>
                <input type="text" name="title" required>
            </div>
            <div class="form-group">
                <label>List:</label>
                <textarea name="list" rows="3"></textarea>
            </div>
             <div class="form-group">
                <label>Type:</label>
                <input type="text" name="type" required  placeholder="'sport','education','personal','work','entertainment'">
            </div>
             <div class="form-group">
                <label> Date To Accomplish:</label>
                <input type="date" name="dateToAccomplish" >
            </div>
            <button type="submit">Create Task</button>
        </form>
    </div>

    <!-- Update Task -->
    <div class="card put">
        <div class="route-header">
            <span class="badge put">PUT</span>
            <span class="route-path">/toUpdate/:title</span>
        </div>
        <form action="/notes/toUpdate" method="POST">
            <div class="form-group">
                <label>Target Title:</label>
                <input type="text" name="targetTitle" required placeholder="Existing title to match route">
            </div>
            <div class="form-group">
                <label>New Task Title:</label>
                <input type="text" name="title">
            </div>
           
            <div class="form-group">
                <label>List:</label>
                <textarea name="list" rows="3"></textarea>
            </div>
             <div class="form-group">
                <label>Type:</label>
                <input type="text" name="type" required  placeholder="'sport','education','personal','work','entertainment'">
            </div>
             <div class="form-group">
                <label> Date To Accomplish:</label>
                <input type="date" name="dateToAccomplish" >
            </div>
            <button type="submit">Update Task</button>
        </form>
    </div>

    <!-- Delete Task -->
    <div class="card delete">
        <div class="route-header">
            <span class="badge delete">DELETE</span>
            <span class="route-path">/toDelete/:title</span>
        </div>
        <form action="/notes/toDelete" method="POST">
            <div class="form-group">
                <label>Task Title to Delete:</label>
                <input type="text" name="title" required>
            </div>
            <button type="submit" style="background-color: var(--danger);">Delete Task</button>
        </form>
    </div>

    <!-- ================= SECTION 2: AUTH & ADMIN ================= -->
    <h2 class="section-title">🔐 Auth & Admin Routes</h2>

    <!-- Register -->
    <div class="card post">
        <div class="route-header">
            <span class="badge post">POST</span>
            <span class="route-path">/register</span>
        </div>
        <form action="/notes/register" method="POST">
            <div class="form-group">
                <label>Email:</label>
                <input type="text" name="email" required>
            </div>
            <div class="form-group">
                <label>Password:</label>
                <input type="password" name="password" required>
            </div>
            <button type="submit">Register Account</button>
        </form>
    </div>

    <!-- Login -->
    <div class="card post">
        <div class="route-header">
            <span class="badge post">POST</span>
            <span class="route-path">/login</span>
        </div>
        <form action="/notes/login" method="POST">
            <div class="form-group">
                <label>Email:</label>
                <input type="text" name="email" required>
            </div>
            <div class="form-group">
                <label>Password:</label>
                <input type="password" name="password" required>
            </div>
            <button type="submit">Login</button>
        </form>
    </div>

    <!-- Admin View -->
    <div class="card get">
        <div class="route-header">
            <span class="badge get">GET</span>
            <span class="route-path">/admin</span>
        </div>
        <p>Access Admin Control Panel.</p>
        <form action="/notes/admin" method="GET">
            <button type="submit">Fetch Admin Form</button>
        </form>
    </div>

    <!-- ================= SECTION 3: MULTER UPLOADS ================= -->
    <h2 class="section-title">📷 Multer Upload Routes</h2>

    <!-- Single Image -->
    <div class="card post">
        <div class="route-header">
            <span class="badge post">POST</span>
            <span class="route-path">/image/single</span>
        </div>
        <span class="info-text">Field name requirement: <code>img</code></span>
        <form action="/notes/image/single" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Select One Image File:</label>
                <input type="file" name="img" required>
            </div>
            <button type="submit">Upload Single Image</button>
        </form>
    </div>

    <!-- Multiple Images (Array) -->
    <div class="card post">
        <div class="route-header">
            <span class="badge post">POST</span>
            <span class="route-path">/image/many</span>
        </div>
        <span class="info-text">Field name requirement: <code>img</code> (Max 3 files)</span>
        <form action="notes/image/many" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Select Multiple Images:</label>
                <input type="file" name="img" multiple required>
            </div>
            <button type="submit">Upload Array of Images</button>
        </form>
    </div>

    
