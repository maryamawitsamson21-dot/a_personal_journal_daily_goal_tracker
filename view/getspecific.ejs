      <!-- ================= SECTION 1: TASKS ================= -->
    <h2 class="section-title">📋 Task Management Routes</h2>
     <!-- Get Specific Task -->
    <div class="card get">
        <div class="route-header">
            <span class="badge get">GET</span>
            <span class="route-path">/homepage/:title</span>
        </div>
     
    </div>

   <% if (data && data.length>0) {%>
    <%data.forEach(task=>{%>
         <div class="card get" style="margin-bottom: 15px; border-left: 5px solid #2ecc71;">
            <div class="route-header">
                <span class="route-path">📌 <%= task.title %></span>
                 <p> <%= task.list %></p>
                  <p> <%= task.type %></p>
                <p> <%= task.dateToAccomplish %></p>
            </div>
  <%  })%>
  <%}else { %>
    <!-- Fallback if your database collection is completely empty -->
    <div class="card" style="border-left-color: #7f8c8d;">
        <p>No tasks found in the database. Create one below!</p>
    </div>
<% } %>